PORT=3000
TEACHER_EMAIL=guru@sekolah.id
TEACHER_PASSWORD=guru123
TEACHER_NAME=Guru Pengampu
SESSION_SECRET=sistem-ulangan-ai-secret-2026
GEMINI_API_KEY=
# NAS/PC lokal: sqlite. Vercel/Turso: remote (kosongkan agar dipilih otomatis dari env Turso).
DATABASE_MODE=
# Batas siswa aktif per ulangan. Nilai produksi dibatasi keras maksimal 20.
MAX_INSIDE_EXAM=20
MAX_BURST_ENTRY=20
MAX_BURST_SUBMIT=20
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DELAY_MIN=5
DELAY_MAX=13

# DATABASE CLOUD (TURSO / LIBSQL - Opsional)
# Isi jika ingin database tersimpan abadi di cloud gratis Turso (AWS Tokyo)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Opsional: direct HTTP adapter otomatis dipakai di Vercel; variabel ini
# hanya diperlukan untuk memaksa adapter HTTP pada runtime non-Vercel.
TURSO_USE_REMOTE_HTTP=
